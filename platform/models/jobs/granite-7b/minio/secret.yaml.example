# Example secret for MinIO credentials
# Copy this file, fill in actual credentials, and apply before running the job
apiVersion: v1
kind: Secret
metadata:
  name: minio-credentials
  namespace: demo
type: Opaque
stringData:
  accessKey: "minioadmin"
  secretKey: "minioadmin"
  endpoint: "minio.minio.svc.cluster.local:9000"
  bucket: "models"
