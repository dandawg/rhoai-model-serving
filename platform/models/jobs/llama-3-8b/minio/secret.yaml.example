# Same MinIO credentials as granite-7b
# Use the same secret or create a separate one
apiVersion: v1
kind: Secret
metadata:
  name: minio-credentials
  namespace: demo
type: Opaque
stringData:
  accessKey: "minioadmin"
  secretKey: "minioadmin"
  endpoint: "minio.minio.svc.cluster.local:9000"
  bucket: "models"
